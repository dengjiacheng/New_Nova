#!/bin/sh

##############################################################################
##
##  Gradle start up script for POSIX generated by Codex
##
##############################################################################

set -e

APP_NAME="Gradle"
APP_BASE_DIR=$(cd "${0%/*}" && pwd -P)
CLASSPATH=$APP_BASE_DIR/gradle/wrapper/gradle-wrapper.jar

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    JAVA_HOME_BIN="$JAVA_HOME/bin"
    JAVA_EXE="$JAVA_HOME_BIN/java"
else
    JAVA_EXE="java"
fi

if [ ! -x "$JAVA_EXE" ] ; then
    echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
    exit 1
fi

# Collect JVM options from environment variables
DEFAULT_JVM_OPTS="-Xmx64m -Xms64m"

# shellcheck disable=SC2086
exec "$JAVA_EXE" ${DEFAULT_JVM_OPTS} \
    -Dorg.gradle.appname="$APP_NAME" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
